app 
    based color         is 1678
    let star_x          is rand 1204
    let star_y          is rand 512
    let x_l_gradient    is (564-2)
    let x_r_gradient    is rand 1204
    let y_up_gradient   is rand 1204
    let y_down_gradient is rand 1204

    ascend [ 
        iterator is star_x
        gradient is x_l_gradient
        xpoint is star_x
        ypoint is star_y
    ]